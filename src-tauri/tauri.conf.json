{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miu Music",
  "version": "0.1.0",
  "identifier": "com.khangkhangg.miumusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miu Music",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#1c1c22"
      },
      {
        "label": "mini",
        "backgroundColor": "#24242c",
        "url": "mini.html",
        "title": "Miu Music",
        "width": 380,
        "height": 200,
        "minWidth": 380,
        "minHeight": 200,
        "maxWidth": 380,
        "maxHeight": 200,
        "resizable": true,
        "maximizable": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: miuart: http://miuart.localhost https:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    }
  }
}
