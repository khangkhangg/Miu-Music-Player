{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miu Music",
  "version": "0.4.1",
  "identifier": "com.khangkhangg.miumusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miu Music",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#1c1c22",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "mini",
        "backgroundColor": "#24242c",
        "url": "mini.html",
        "title": "Miu Music",
        "width": 380,
        "height": 200,
        "minWidth": 380,
        "minHeight": 200,
        "maxWidth": 380,
        "maxHeight": 200,
        "resizable": true,
        "maximizable": true,
        "visible": false,
        "center": false,
        "create": false
      },
      {
        "label": "party",
        "url": "party.html",
        "title": "Miu Party",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#111115",
        "visible": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: miuart: http://miuart.localhost https:; style-src 'self'; script-src 'self'; frame-src https://www.youtube.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4M0VERTI2MUU5NjI4M0EKUldRNktKWWVKdDQrMlB6dzh6d3lhOSs4bVJaRVFjNVkyZHNpc08xN1RrekVKWFJkZTV2NFdFVnMK",
      "endpoints": [
        "https://github.com/khangkhangg/Miu-Music-Player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
