{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miu Music",
  "version": "0.1.0",
  "identifier": "com.khangkhangg.miumusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miu Music",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600
      },
      {
        "label": "mini",
        "url": "mini.html",
        "title": "Miu Music",
        "width": 380,
        "height": 200,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: miuart: http://miuart.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
